<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  IgnorableNamespaces="uap rescap desktop desktop4 uap5">

  <Identity
    Name="ProbityDataAnalytics.5701382B25AF5"
    Publisher="CN=1760E4F3-7B38-4A64-8D2D-B4F7703D7D10"
    Version="3.5.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>RailReader2</DisplayName>
    <PublisherDisplayName>Probity Data Analytics</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>AI-guided rail reading PDF viewer for comfortable high-magnification reading of academic documents.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="RailReader2"
      Executable="RailReader2.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="RailReader2"
        Description="AI-guided rail reading PDF viewer"
        BackgroundColor="#141c2b"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\LargeTile.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- PDF file type association -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:DisplayName>PDF Document</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- Reading package (.railreading) association -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="railreading">
            <uap:DisplayName>RailReader2 Reading Package</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.railreading</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>

    </Application>

    <!-- railreader2-mcp: the read-only MCP server AI tools connect to (roadmap M8). Not in the Start menu;
         reached through its execution alias, which Windows keeps at a stable path
         (%LOCALAPPDATA%\Microsoft\WindowsApps\railreader2-mcp.exe) across Store updates. A console
         program: the agent talks to it over stdin/stdout. Runs inside the package, so it sees the same
         (possibly virtualised) AppData as the app. Checked by msix/test-msix-install.ps1. -->
    <Application Id="RailReader2Mcp"
      Executable="RailReader2.Mcp.exe"
      EntryPoint="Windows.FullTrustApplication"
      desktop4:Subsystem="console"
      desktop4:SupportsMultipleInstances="true">

      <uap:VisualElements
        DisplayName="RailReader2 MCP server"
        Description="Lets AI tools read your RailReader2 notes"
        BackgroundColor="#141c2b"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />

      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="railreader2-mcp.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
