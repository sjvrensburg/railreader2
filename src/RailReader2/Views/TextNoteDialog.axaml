<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RailReader2.Views.TextNoteDialog"
        Title="Text Note"
        Width="420" Height="260"
        MinWidth="300" MinHeight="180"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" x:Name="SpellingStatus"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Opacity="0.7"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                <Button Content="OK" Width="80" Click="OnOkClick" />
                <Button Content="Cancel" Width="80" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
        <TextBox x:Name="NoteTextBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 PlaceholderText="Enter note text..." />
    </DockPanel>
</Window>
