<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RailReader2.Views.SplashWindow"
        Width="360" Height="240"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        WindowDecorations="None"
        Background="#F5F5F5"
        TransparencyLevelHint="None">
    <Border CornerRadius="8" ClipToBounds="True">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <Image Source="avares://RailReader2/Assets/railreader2.png"
                   Width="80" Height="80"
                   HorizontalAlignment="Center" />
            <TextBlock Text="railreader2"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#1E1E2E"
                       HorizontalAlignment="Center" />
            <TextBlock Text="AI-guided rail reading"
                       FontSize="13"
                       Foreground="#585B70"
                       HorizontalAlignment="Center" />
            <!-- Named so the code-behind can stop the indeterminate animation in OnClosing: Avalonia
                 does not cancel a looping style animation when its window closes (AvaloniaUI/Avalonia
                 #16648, #13139), and a still-subscribed animation keeps MediaContext's 16 ms render
                 timer armed for the life of the process — which the X11 dispatcher turns into a
                 100%-CPU spin of the UI thread. -->
            <ProgressBar Name="Bar"
                         IsIndeterminate="True"
                         Width="120" Height="3"
                         Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</Window>
