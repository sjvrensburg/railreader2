<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RailReader2.ViewModels"
        xmlns:v="using:RailReader2.Views"
        xmlns:c="using:RailReader2.Controls"
        xmlns:a="using:Avalonia.Automation"
        x:Class="RailReader2.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="railreader2"
        Width="1200" Height="900"
>

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- Menu Bar -->
        <v:MenuBarView DockPanel.Dock="Top" DataContext="{Binding}"
                       IsVisible="{Binding !IsFullScreen}" />

        <!-- Tab strip with a leading sidebar toggle (shows/hides the side panel and reflects
             its state). Visible in windowed mode, or on hover at the top edge in fullscreen. -->
        <DockPanel DockPanel.Dock="Top" IsVisible="{Binding IsTabBarVisible}"
                   Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <ToggleButton Name="SidebarToggle" Classes="toolBtn borderless" DockPanel.Dock="Left"
                          IsChecked="{Binding ShowOutline, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="4,0,2,0"
                          ToolTip.Tip="Toggle side panel"
                          a:AutomationProperties.Name="Toggle side panel"
                          a:AutomationProperties.AutomationId="SidebarToggle">
                <c:Icon Data="{StaticResource IconPanelLeft}" />
            </ToggleButton>
            <v:TabBarView Name="TabBar" DataContext="{Binding}" />
        </DockPanel>

        <!-- Status Bar (visible in windowed mode, or on hover at bottom edge in fullscreen) -->
        <v:StatusBarView x:Name="StatusBar" DockPanel.Dock="Bottom" DataContext="{Binding}"
                         IsVisible="{Binding IsStatusBarVisible}" />

        <!-- Main Content: resizable sidebar + viewport -->
        <Grid Name="MainGrid" ColumnDefinitions="220,Auto,*">
            <!-- Outline Panel (resizable via GridSplitter) -->
            <v:OutlinePanel Name="OutlinePanel" Grid.Column="0"
                            DataContext="{Binding}"
                            MinWidth="200" MaxWidth="600"
                            IsVisible="{Binding ShowOutline}" />

            <!-- Drag handle to resize sidebar -->
            <GridSplitter Grid.Column="1" Width="4"
                          ResizeDirection="Columns"
                          Background="Transparent"
                          IsVisible="{Binding ShowOutline}" />

            <!-- Content area -->
            <DockPanel Grid.Column="2">
                <v:RailToolBar Name="RailToolBar"
                               DockPanel.Dock="Right"
                               IsVisible="False" />

                <Panel>
                    <!-- Pane grid: the primary self-contained PDF viewport (layers + minimap +
                         annotation toolbar + scan-all), always present and always sized. Split
                         panes add columns + GridSplitters here at runtime (PaneManager); each pane
                         renders its own viewport of the active document. Renders empty when none open. -->
                    <Grid Name="PaneGrid" ColumnDefinitions="*">
                        <v:DocumentView Name="Document" Grid.Column="0" />
                    </Grid>

                    <!-- Welcome panel when no document is open (also the AppImage catalogue's
                         automatic screenshot, which launches with no arguments) -->
                    <Border Name="WelcomePanel"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            IsVisible="{Binding !Tabs.Count}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="10" MaxWidth="520">
                            <!-- The logo is black on transparent, so it sits on a light tile to stay
                                 visible in the dark theme -->
                            <Border Background="White" CornerRadius="22" Padding="10"
                                    HorizontalAlignment="Center">
                                <Image Source="avares://RailReader2/Assets/railreader2.png"
                                       Width="96" Height="96" />
                            </Border>
                            <TextBlock Text="railreader2" FontSize="32" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="AI-guided rail reading for comfortable high-magnification PDF reading"
                                       FontSize="15" Opacity="0.7" TextWrapping="Wrap"
                                       TextAlignment="Center" HorizontalAlignment="Center" />
                            <Button Content="Open a PDF…" Command="{Binding OpenFileCommand}"
                                    HorizontalAlignment="Center" Margin="0,14,0,6"
                                    Padding="24,8" FontSize="15"
                                    a:AutomationProperties.Name="Open a PDF"
                                    a:AutomationProperties.AutomationId="WelcomeOpenButton" />
                            <TextBlock Text="or press Ctrl+O" Opacity="0.55"
                                       HorizontalAlignment="Center" />
                            <Border Height="1" Opacity="0.2" Margin="0,16,0,6"
                                    Background="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="16" RowSpacing="6" HorizontalAlignment="Center"
                                  Opacity="0.75">
                                <TextBlock Grid.Row="0" Text="Zoom in" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Past 3× the page locks to one text block at a time" />
                                <TextBlock Grid.Row="1" Text="Read" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Down or S advances line by line; P auto-scrolls" />
                                <TextBlock Grid.Row="2" Text="R" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Start rail reading at any zoom" />
                                <TextBlock Grid.Row="3" Text="Ctrl+E" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Annotate: highlight, draw, add notes" />
                                <TextBlock Grid.Row="4" Text="C" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Cycle colour effects for comfort" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Panel>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
