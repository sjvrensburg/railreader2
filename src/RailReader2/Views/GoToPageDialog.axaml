<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RailReader2.Views.GoToPageDialog"
        Title="Go to Page"
        Width="280" Height="140"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="OK" MinWidth="80" HorizontalContentAlignment="Center" Click="OnOkClick" />
            <Button Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center" Click="OnCancelClick" />
        </StackPanel>
        <StackPanel Spacing="8">
            <TextBox x:Name="PageInput" />
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
    </DockPanel>
</Window>
