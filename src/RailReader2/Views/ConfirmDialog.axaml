<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RailReader2.Views.ConfirmDialog"
        Title="Confirm"
        Width="450" SizeToContent="Height" MinHeight="150"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="ConfirmButton" MinWidth="100" HorizontalContentAlignment="Center" Click="OnConfirmClick" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" />
    </DockPanel>
</Window>
