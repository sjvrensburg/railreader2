<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shell services the app and the CLI both need (the OCR text-layer job, portals, view rotation,
       the reading package). Core-only, no Avalonia.
       Document identity and the JSON sidecar helper now live in RailReader.Core.Pdfium. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RailReader2" />
    <InternalsVisibleTo Include="RailReader2.Cli" />
    <InternalsVisibleTo Include="RailReader.Export.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RailReader.Core" Version="0.76.0" />
    <PackageReference Include="RailReader.Core.Pdfium" Version="0.76.0" />
  </ItemGroup>
</Project>
