<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shell services the app and the CLI both need (content-based document identity and the JSON
       sidecar helper it saves with). Core-only, no Avalonia. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RailReader2" />
    <InternalsVisibleTo Include="RailReader2.Cli" />
    <InternalsVisibleTo Include="RailReader.Export.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RailReader.Core" Version="0.74.1" />
    <PackageReference Include="RailReader.Core.Pdfium" Version="0.74.1" />
  </ItemGroup>
</Project>
