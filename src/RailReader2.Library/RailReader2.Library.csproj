<Project Sdk="Microsoft.NET.Sdk">
  <!-- Library-wide search index (M7, docs/library-search-design.md). Core-only, no Avalonia, shared by
       app + CLI like RailReader2.References. Carries the SQLite dependency so it stays out of Shared. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RailReader2" />
    <InternalsVisibleTo Include="RailReader2.Cli" />
    <InternalsVisibleTo Include="RailReader.Export.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="RailReader.Core" Version="0.91.0" />
    <PackageReference Include="RailReader.Core.Pdfium" Version="0.91.0" />
  </ItemGroup>
</Project>
